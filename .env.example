DISCORD_TOKEN=your-bot-token
# Leave BLANK to work in every server (global commands).
# Only set this while testing: commands then appear instantly, but ONLY in that one server.
GUILD_ID=

# --- Live alerts (/live) ---
# Twitch: https://dev.twitch.tv/console/apps  (create an app, copy Client ID + generate a secret)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Kick: https://docs.kick.com (create an app in your Kick account developer settings)
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
# YouTube Data API v3 key (Google Cloud Console). Needed for YouTube live detection and handle lookups.
YOUTUBE_API_KEY=

# --- Social feeds (/feed) ---
# Base URL of an RSSHub instance, used for X/Twitter, TikTok and Instagram feeds.
# The public one is unreliable and often blocked; self-hosting is strongly recommended.
RSSHUB_URL=https://rsshub.app

# --- Web dashboard (optional; leave blank to run the bot without it) ---
# Discord Developer Portal > your app > OAuth2: copy the Client ID and Client Secret,
# then add  <WEB_BASE_URL>/callback  under "Redirects".
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Public address of the dashboard. Discord only accepts http:// for localhost; anything else needs https://
WEB_BASE_URL=http://localhost:3000
WEB_PORT=3000
# 127.0.0.1 = only this computer / a reverse proxy on it. Use 0.0.0.0 only if you know you need it.
WEB_HOST=127.0.0.1
# Set to 1 when running behind a reverse proxy such as Caddy or nginx
WEB_TRUST_PROXY=
