<?xml version="1.0" encoding="UTF-8"?>
<!-- Put this in the root folder of an IIS site bound to bot.yourdomain.com.
     Needs the URL Rewrite and Application Request Routing (proxy enabled) modules. -->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="BotDashboard" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:3000/{R:1}" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
